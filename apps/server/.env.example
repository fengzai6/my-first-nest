# -------------------------------------------------------------------
# Environment variables template for my-first-nest
#
# How to use:
# 1. Create a copy of this file named ".env".
# 2. Fill in the values for your environment.
# 3. The application will load these variables on startup.
# -------------------------------------------------------------------

# ===================================================================
# Required - 必须为这些变量提供值
# ===================================================================

# Database
# 应用程序的 PostgreSQL 连接字符串
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=first-nest
# Or use DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/first-nest
# 在开发过程中，是否让 TypeORM 自动同步数据库结构。
# 警告：在生产环境中，应始终设置为 false，并使用数据库迁移（migrations）。
DATABASE_SYNCHRONIZE=true

# Initial Admin User
# 用于系统初始化的默认管理员账户
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="admin1234"

# JWT
# 用于签名和验证 JSON Web Tokens 的密钥。
# 警告：请务必使用一个长而复杂的随机字符串，以确保安全。
JWT_SECRET="your-super-secret-and-long-string"

# Attachment
# 用于签发私有附件访问 URL 的独立密钥，不要与 JWT_SECRET 复用。
# 警告：请务必使用一个长而复杂的随机字符串，以确保安全。
UPLOAD_SIGNATURE_SECRET="your-upload-signature-secret"

# ===================================================================
# Optional - 这些变量有默认值，但可以根据需要覆盖，默认值在 src/config/config.default.ts 中查看
# ===================================================================

# Node Environment
# development | production | test
# NODE_ENV=development

# Server
# 应用程序监听的端口
# PORT=3174

# Swagger
# 是否启用 Swagger UI (API 文档)
# SWAGGER_OPEN=true

# JWT
# 设置 JWT 的过期时间
# JWT_ACCESS_EXPIRES_IN=3600
# JWT_REFRESH_EXPIRES_IN=604800

# Snowflake ID Generator
# 用于分布式ID生成的雪花算法配置
# 工作节点ID（0-31）
# WORKER_ID=0
# 数据中心ID（0-31）
# DATACENTER_ID=0

# Throttler
# 默认限流窗口，单位毫秒
# THROTTLER_TTL=60000
# 窗口内最大请求数
# THROTTLER_LIMIT=60

# Redis (Optional for cache - 不提供任何 REDIS_URL / REDIS_HOST 时，缓存模块自动降级为内存 store)
# 注意：BullMQ 任务系统依赖 Redis；未配置时 Jobs 模块会初始化失败
# REDIS_URL=redis://localhost:6379
# 或者使用单独的连接参数（与 REDIS_URL 二选一）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# 缓存默认 TTL，单位：秒（0 表示不过期）
# REDIS_DEFAULT_TTL=300
# Key 前缀，用于多实例 / 多环境隔离
# REDIS_KEY_PREFIX=my-first-nest:

# Logging
# LOG_RETENTION_DAYS=30
# LOG_BATCH_SIZE=50
# LOG_FLUSH_INTERVAL_MS=5000

# Seq (set SEQ_ENABLED=true only when SEQ_URL is reachable)
# SEQ_ENABLED=false
# SEQ_URL=http://localhost:5341
# SEQ_API_KEY=
# SEQ_TIMEOUT_MS=5000

# Attachments
# 本地附件存储根目录
# UPLOAD_DIR=uploads
# 附件内容访问前缀
# UPLOAD_URL_PREFIX=/api/attachments/content
# 私有附件签名 URL 有效期，单位秒
# UPLOAD_SIGNED_URL_EXPIRES_IN=300
# 已删除或孤儿附件的最短保留天数，最小 1
# ATTACHMENT_CLEANUP_RETENTION_DAYS=7
# 每轮清理候选查询最大条数，范围 1-1000
# ATTACHMENT_CLEANUP_BATCH_SIZE=100
